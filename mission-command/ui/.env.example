# Mastra API Configuration
# The base URL of the Mastra Server API
VITE_MASTRA_API_URL=http://localhost:4111

# Development Mode
# Set to 'true' to enable mock dev login (bypasses OAuth)
VITE_DEV_MODE=true

# OAuth Provider Configuration (optional - Mastra Server handles this)
# These are used by the Mastra Server, not directly by the UI
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
