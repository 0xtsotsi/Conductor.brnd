# Mission Command Centre - Environment Variables

# Database Configuration
# PostgreSQL connection string for persistent storage
DATABASE_URL=postgresql://user:password@localhost:5432/mission_command

# GitHub Configuration
# GitHub Token for API access
# Generate at: https://github.com/settings/tokens
# Required permissions: repo (full repository access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Webhook Secret
# Used to verify webhook signatures from GitHub
# Generate a random secret and configure it in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_here

# Server Configuration
# Port for the Mastra server (default: 4111)
PORT=4111

# Cleanup Configuration (Optional)
# Interval for automatic cleanup of expired suspended runs (default: 1 hour)
CLEANUP_INTERVAL_MS=3600000

# Rate Limit Cleanup Interval (Optional)
# Interval for cleaning up expired rate limit entries (default: 1 minute)
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
