# Mission Command Centre - Environment Variables

# ============================================
# Authentication & OAuth Configuration
# ============================================

# JWT Secret for token signing
# IMPORTANT: Change this to a secure random string in production!
JWT_AUTH_SECRET=your-super-secret-key-change-this

# Frontend URL (for OAuth redirects)
# This should match where your UI is running
FRONTEND_URL=http://localhost:3000

# GitHub OAuth App Configuration
# Create at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:4111/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth App Configuration
# Create at: https://console.cloud.google.com
# Set Authorized redirect URI to: http://localhost:4111/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Default role for new users
# Options: admin, operator, viewer
DEFAULT_ROLE=viewer

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Database (Primary)
# Connection string for persistent storage
DATABASE_URL=postgresql://mission_command:mission_command_password@localhost:5432/mission_command_db

# LibSQL Database (Fallback/Alternative)
# Used as fallback or for local development
# Can use file-based storage or remote LibSQL instance
LIBSQL_URL=file:mission-command.db

# ============================================
# GitHub Integration
# ============================================

# GitHub Token for API access
# Generate at: https://github.com/settings/tokens
# Required permissions: repo (full repository access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Webhook Secret
# Used to verify webhook signatures from GitHub
# Generate a random secret and configure it in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_here

# ============================================
# Server Configuration
# ============================================

# Port for the Mastra server (default: 4111)
PORT=4111

# Cleanup Configuration (Optional)
# Interval for automatic cleanup of expired suspended runs (default: 1 hour)
CLEANUP_INTERVAL_MS=3600000

# Rate Limit Cleanup Interval (Optional)
# Interval for cleaning up expired rate limit entries (default: 1 minute)
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
