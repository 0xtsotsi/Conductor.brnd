# Mission Command Centre - Environment Configuration

# ==================================================
# Authentication & OAuth
# ==================================================

# JWT Secret for token signing (REQUIRED)
# Generate with: openssl rand -base64 32
JWT_AUTH_SECRET=your-super-secret-key-change-this-in-production

# Frontend URL for OAuth redirects (REQUIRED)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth App (Optional - omit to disable GitHub login)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth App (Optional - omit to disable Google login)
# Create at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Default role for new OAuth users (Optional, default: viewer)
# Options: admin, operator, viewer
DEFAULT_ROLE=viewer

# ==================================================
# Database
# ==================================================

# PostgreSQL for production (REQUIRED for production)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mission_command:password@localhost:5432/mission_command

# Or use LibSQL for development (Optional)
# LIBSQL_URL=file:mission-command.db

# ==================================================
# API & Server
# ==================================================

# Mastra API URL (Frontend uses this to connect to server)
# Default: http://localhost:4111
VITE_MASTRA_API_URL=http://localhost:4111

# Server port (Optional, default: 4111)
PORT=4111

# Node environment (Optional)
NODE_ENV=development

# ==================================================
# GitHub Integration
# ==================================================

# GitHub Token for API access
# Generate at: https://github.com/settings/tokens
# Required permissions: repo (full repository access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub webhook secret (Optional, for webhook verification)
# Generate with: openssl rand -base64 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ==================================================
# Deployment (Production Only)
# ==================================================

# Domain name (for production deployment)
DOMAIN=missioncommand.com

# AWS Configuration (if using ECS deployment)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# SSL Certificate (if using custom domain)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
