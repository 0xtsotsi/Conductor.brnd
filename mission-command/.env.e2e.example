# Mission Command Centre - E2E Test Environment Variables
# Copy this file to .env.e2e and fill in the values

# Base URL of the application under test
# For local development: http://localhost:4111
# For CI: Use the deployed application URL
BASE_URL=http://localhost:4111

# Run tests in headed mode (true/false)
# Set to true to see browser window during tests
HEADED=false

# CI environment detection
# Set to true when running in CI/CD pipeline
CI=false

# Test user credentials
# These users will be created during test setup
E2E_ADMIN_EMAIL=admin@test.local
E2E_ADMIN_PASSWORD=test-password-admin

E2E_OPERATOR_EMAIL=operator@test.local
E2E_OPERATOR_PASSWORD=test-password-operator

E2E_VIEWER_EMAIL=viewer@test.local
E2E_VIEWER_PASSWORD=test-password-viewer

# GitHub test configuration
# Use a test GitHub token for E2E tests
GITHUB_TOKEN=ghp_test_token_for_e2e_tests

# Database configuration for test database
# Should be a separate database from development/production
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/mission_command_test

# GitHub webhook secret for testing
GITHUB_WEBHOOK_SECRET=test-webhook-secret-for-e2e

# Test timeout configuration (milliseconds)
TEST_TIMEOUT=30000

# Screenshot and video recording
# Set to 'always' to capture screenshots/videos for all tests
# Set to 'on-failure' to capture only on test failures
# Set to 'never' to disable
SCREENSHOT=on-failure
VIDEO=on-failure

# Test data cleanup
# Set to true to automatically clean up test data after tests
CLEANUP_TEST_DATA=true
